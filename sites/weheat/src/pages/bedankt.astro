---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../sites';
import { url } from '../lib/links';
const t = site.thanks;
---

<Base title={`${t.title} | ${site.name}`} description={t.text} noindex stickyCta={false}>
  <section class="mx-auto max-w-2xl px-4 py-20 sm:px-6">
    <div class="rounded-card border border-line bg-surface p-8 text-center sm:p-12">
      <span class="mx-auto grid size-16 place-items-center rounded-full bg-primary text-white">
        <Icon name="check" class="size-8" />
      </span>
      <h1 class="font-display mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{t.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{t.text}</p>
      <div class="mt-8 rounded-card bg-bg p-6 text-left">
        <h2 class="font-display font-bold">Wat je alvast kunt doen</h2>
        <ul class="mt-3 space-y-2">
          {
            t.next.map((n) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                {n}
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mt-8 text-sm text-muted">
        Vragen? Bel <a href={site.phone.href} class="font-semibold text-ink underline">{site.phone.display}</a>
      </p>
      <a href={url('/')} class="btn btn-ghost mt-6">Terug naar de homepage</a>
    </div>
  </section>
  <script is:inline>
    // Conversie-event voor GTM/GA4 (alleen zinvol als er een container is ingesteld)
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lead_thankyou' });
  </script>
</Base>

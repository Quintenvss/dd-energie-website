---
import Base from '../layouts/Base.astro';
import { site } from '../sites';
import { url } from '../lib/links';
---

<Base title={`Pagina niet gevonden | ${site.name}`} description="Deze pagina bestaat niet." noindex stickyCta={false}>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-display text-6xl font-bold text-primary">404</p>
    <h1 class="font-display mt-4 text-3xl font-bold tracking-tight">Deze pagina bestaat niet</h1>
    <p class="mt-3 text-muted">Ga terug naar de homepage of vraag direct een offerte aan.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={url('/')} class="btn btn-ghost">Homepage</a>
      <a href={url('/#aanvraag')} class="btn btn-primary">{site.funnel.submitLabel}</a>
    </div>
  </section>
</Base>

---
interface Props {
  title: string;
  intro?: string;
  /** Klein label boven de kop (redactionele stijl, weheatofferte.nl) */
  overline?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { title, intro, overline, align = 'left', light = false } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {
    overline && (
      <p class="mb-3 flex items-center gap-3 text-xs font-bold tracking-[0.18em] text-primary uppercase">
        <span class="h-px w-8 bg-primary" aria-hidden="true" />
        {overline}
      </p>
    )
  }
  <h2
    class:list={[
      'font-display text-3xl font-bold tracking-tight sm:text-4xl',
      light ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {intro && <p class:list={['mt-3 text-lg leading-relaxed', light ? 'text-white/75' : 'text-muted']}>{intro}</p>}
</div>

---
/**
 * USP's in drie stijlen:
 *  - sky:   vier losse kaarten
 *  - ember: één strakke balk met hairlines (zakelijk)
 *  - mint:  compacte vertrouwensrij op wit, zoals in een webshop
 */
import { site } from '../sites';
import Icon from './Icon.astro';
const v = site.theme;
---

{
  v === 'sky' && (
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {site.usps.map((u) => (
          <li class="reveal rounded-card border border-line bg-surface p-6">
            <span class="grid size-11 place-items-center rounded-field bg-soft text-primary-dark">
              <Icon name={u.icon} class="size-5" />
            </span>
            <h3 class="font-display mt-4 text-lg font-bold">{u.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{u.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  v === 'ember' && (
    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <ul class="reveal grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {site.usps.map((u) => (
          <li class="flex gap-4 bg-surface p-6">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary text-white">
              <Icon name={u.icon} class="size-5" />
            </span>
            <div>
              <h3 class="font-display font-bold">{u.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{u.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  v === 'mint' && (
    <section class="border-b border-line bg-surface">
      <ul class="mx-auto grid max-w-6xl gap-6 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        {site.usps.map((u) => (
          <li class="reveal flex gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-soft text-primary-dark">
              <Icon name={u.icon} class="size-5" />
            </span>
            <div>
              <h3 class="font-display text-base font-bold">{u.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{u.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

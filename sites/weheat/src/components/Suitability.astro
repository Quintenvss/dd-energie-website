---
import { site } from '../sites';
import SectionHead from './SectionHead.astro';
const s = site.suitability;
const fitClass = {
  Hybride: 'bg-soft text-primary-dark',
  'All-electric': 'bg-dark text-white',
  Beide: 'bg-accent text-ink',
};
---

{
  s && (
    <section class="bg-surface">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <SectionHead title={s.title} intro={s.intro} />
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {s.cards.map((c) => (
            <article class="reveal flex flex-col rounded-card border border-line bg-bg p-6">
              <span class:list={['self-start rounded-full px-3 py-1 text-xs font-bold', fitClass[c.fit]]}>
                {c.fit === 'Beide' ? 'Hybride of all-electric' : c.fit}
              </span>
              <h3 class="font-display mt-4 text-lg font-bold leading-snug">{c.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{c.text}</p>
            </article>
          ))}
        </div>
        <p class="reveal mt-6 text-sm text-muted">
          Twijfel je in welke groep jouw woning valt? Doe de check, dan beoordeelt een installateur het voor je.
        </p>
      </div>
    </section>
  )
}

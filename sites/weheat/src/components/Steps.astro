---
/**
 * Stappen in drie stijlen:
 *  - sky:   horizontaal met verbindingslijn
 *  - ember: verticale tijdlijn naast een vaste kop
 *  - mint:  genummerde kaarten met groot cijfer
 */
import { site } from '../sites';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
const s = site.steps;
const v = site.theme;
---

{
  v === 'sky' && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHead title={s.title} intro={s.intro} />
      <ol class="mt-10 grid gap-6 md:grid-cols-4">
        {s.items.map((step, i) => (
          <li class="reveal relative">
            <div class="flex items-center gap-3">
              <span class="font-display grid size-10 shrink-0 place-items-center rounded-full bg-primary text-sm font-bold text-white">
                {i + 1}
              </span>
              {i < s.items.length - 1 && <span class="hidden h-px flex-1 bg-line md:block" aria-hidden="true" />}
            </div>
            <h3 class="font-display mt-4 text-lg font-bold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  v === 'ember' && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr]">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <SectionHead overline="Werkwijze" title={s.title} intro={s.intro} />
          <a href="#aanvraag" class="btn btn-primary mt-6">
            {site.funnel.submitLabel} <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
        <ol class="relative ml-4 border-l-2 border-line pl-8">
          {s.items.map((step, i) => (
            <li class="reveal relative pb-10 last:pb-0">
              <span class="font-display absolute top-0 -left-[calc(3rem+1px)] grid size-8 place-items-center rounded-full bg-primary text-sm font-bold text-white ring-4 ring-bg">
                {i + 1}
              </span>
              <h3 class="font-display text-lg font-bold">{step.title}</h3>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-muted">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  v === 'mint' && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHead title={s.title} intro={s.intro} align="center" />
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {s.items.map((step, i) => (
          <li class="reveal relative overflow-hidden rounded-card border border-line bg-surface p-6">
            <span
              class="font-display pointer-events-none absolute -top-4 -right-2 text-8xl font-extrabold text-soft"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="font-display relative grid size-9 place-items-center rounded-full bg-primary text-sm font-bold text-white">
              {i + 1}
            </span>
            <h3 class="font-display relative mt-4 text-lg font-bold">{step.title}</h3>
            <p class="relative mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

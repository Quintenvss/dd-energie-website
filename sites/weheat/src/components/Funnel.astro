---
/**
 * Multi-step aanvraagformulier. Vragen komen uit site.funnel.questions;
 * de contactstap is altijd de laatste. Logica: src/scripts/funnel.ts
 */
import { site } from '../sites';
import Icon from './Icon.astro';
import { url } from '../lib/links';

interface Props {
  id?: string;
  class?: string;
}
const { id = 'aanvraag', class: cls = '' } = Astro.props;
const f = site.funnel;
const total = f.questions.length + 1;
---

<form
  id={id}
  class:list={['funnel scroll-mt-24 rounded-card bg-surface p-5 shadow-2xl shadow-dark/15 sm:p-8', cls]}
  data-endpoint={f.endpoint}
  data-fallback={f.fallbackEmail}
  data-site={site.key}
  data-domain={site.domain}
  data-phone={site.phone.display}
  data-thanks={url('/bedankt/')}
  novalidate
>
  <div class="mb-5">
    <div class="flex items-center justify-between gap-3 text-xs font-semibold text-muted">
      <span data-step-label>Stap 1 van {total}</span>
      <span class="truncate">{f.title}</span>
    </div>
    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-soft">
      <div
        class="h-full rounded-full bg-primary transition-all duration-300"
        data-progress
        style={`width:${100 / total}%`}
      >
      </div>
    </div>
  </div>

  {
    f.questions.map((q, i) => (
      <fieldset class="funnel-step" data-step={i} hidden={i !== 0}>
        <legend class="font-display text-xl font-bold leading-snug">{q.title}</legend>
        {q.hint && <p class="mt-1 text-sm text-muted">{q.hint}</p>}
        <div class="mt-4 grid gap-2.5">
          {q.options.map((o) => (
            <label class="choice">
              <input type="radio" name={q.name} value={o.value} required />
              <span class="choice-mark" />
              <span class="grid">
                <span class="font-semibold leading-tight">{o.label}</span>
                {o.hint && <span class="mt-0.5 text-xs text-muted">{o.hint}</span>}
              </span>
            </label>
          ))}
        </div>
        <div class="mt-5 flex items-center justify-between gap-3">
          <button type="button" class="btn btn-ghost btn-sm" data-back hidden={i === 0}>
            <Icon name="arrow-left" class="size-4" /> Terug
          </button>
          <button type="button" class="btn btn-primary ml-auto" data-next>
            Volgende <Icon name="arrow-right" class="size-4" />
          </button>
        </div>
      </fieldset>
    ))
  }

  <fieldset class="funnel-step" data-step={f.questions.length} hidden>
    <legend class="font-display text-xl font-bold leading-snug">{f.contactTitle}</legend>
    {f.contactHint && <p class="mt-1 text-sm text-muted">{f.contactHint}</p>}
    <div class="mt-4 grid gap-3">
      <label class="grid gap-1.5">
        <span class="text-xs font-semibold">Naam*</span>
        <input class="field" type="text" name="naam" autocomplete="name" required />
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="grid gap-1.5">
          <span class="text-xs font-semibold">E-mailadres*</span>
          <input class="field" type="email" name="email" autocomplete="email" required />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-semibold">Telefoonnummer*</span>
          <input class="field" type="tel" name="telefoon" autocomplete="tel" required />
        </label>
      </div>
      <div class="grid grid-cols-[1fr_auto] gap-3">
        <label class="grid gap-1.5">
          <span class="text-xs font-semibold">Postcode*</span>
          <input
            class="field"
            type="text"
            name="postcode"
            autocomplete="postal-code"
            placeholder="1234 AB"
            pattern="^[1-9][0-9]{3}\s?[A-Za-z]{2}$"
            required
          />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-semibold">Huisnr.*</span>
          <input class="field w-24" type="text" name="huisnummer" required />
        </label>
      </div>
      <div class="hp" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
    </div>
    <div class="mt-5 flex items-center gap-3">
      <button type="button" class="btn btn-ghost btn-sm" data-back>
        <Icon name="arrow-left" class="size-4" /> Terug
      </button>
      <button type="submit" class="btn btn-primary flex-1" data-submit>{f.submitLabel}</button>
    </div>
    <p class="mt-3 text-center text-xs leading-relaxed text-muted">{f.footnote}</p>
  </fieldset>

  <p class="funnel-status mt-4 hidden rounded-field px-4 py-3 text-sm" role="status"></p>
</form>

<script>
  import '../scripts/funnel';
</script>

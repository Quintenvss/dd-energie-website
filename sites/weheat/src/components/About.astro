---
/**
 * Merkblok in drie stijlen:
 *  - sky:   donker blok
 *  - ember: licht kader met oranje zijlijn
 *  - mint:  lichte band van rand tot rand
 */
import { Image } from 'astro:assets';
import { site } from '../sites';
import Icon from './Icon.astro';
import logo from '../assets/weheat.webp';
const a = site.about;
const v = site.theme;
---

{
  v === 'sky' && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="reveal grid items-center gap-10 rounded-card bg-dark p-8 text-white sm:p-12 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <div class="inline-block rounded-field bg-white px-5 py-3">
            <Image src={logo} alt="Weheat logo" width={200} class="h-12 w-auto" />
          </div>
          <h2 class="font-display mt-6 text-3xl font-bold tracking-tight">{a.title}</h2>
        </div>
        <div>
          <p class="text-lg leading-relaxed text-white/80">{a.text}</p>
          <ul class="mt-6 grid gap-2 sm:grid-cols-2">
            {a.points.map((p) => (
              <li class="flex items-center gap-2 text-sm font-medium">
                <Icon name="check" class="size-4 shrink-0 text-accent" />
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

{
  v === 'ember' && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="reveal grid gap-8 rounded-card border border-line border-l-4 border-l-primary bg-surface p-8 sm:p-10 lg:grid-cols-[auto_1fr] lg:items-center">
        <div class="grid place-items-center rounded-card border border-line bg-bg px-8 py-6">
          <Image src={logo} alt="Weheat logo" width={200} class="h-12 w-auto" />
        </div>
        <div>
          <p class="text-xs font-bold tracking-[0.18em] text-primary uppercase">Over het merk</p>
          <h2 class="font-display mt-1 text-2xl font-bold">{a.title}</h2>
          <p class="mt-3 leading-relaxed text-muted">{a.text}</p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {a.points.map((p) => (
              <li class="flex items-center gap-2 text-sm font-medium">
                <Icon name="check" class="size-4 shrink-0 text-primary" />
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

{
  v === 'mint' && (
    <section class="border-y border-line bg-soft/40">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_1.6fr]">
        <div class="reveal">
          <div class="inline-block rounded-card bg-surface px-8 py-6 shadow-sm">
            <Image src={logo} alt="Weheat logo" width={200} class="h-12 w-auto" />
          </div>
          <h2 class="font-display mt-6 text-3xl font-bold tracking-tight">{a.title}</h2>
        </div>
        <div class="reveal">
          <p class="text-lg leading-relaxed text-muted">{a.text}</p>
          <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
            {a.points.map((p) => (
              <li class="flex items-center gap-2.5 text-sm font-medium">
                <span class="grid size-5 shrink-0 place-items-center rounded-full bg-primary text-white">
                  <Icon name="check" class="size-3" />
                </span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

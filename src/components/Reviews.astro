---
import Eyebrow from './Eyebrow.astro';
import { url } from '../lib/links';
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="reveal grid items-center gap-10 rounded-3xl bg-white p-8 sm:p-12 md:grid-cols-[auto_1fr]">
    <div class="text-center md:pr-10 md:text-left">
      <Eyebrow label="Klanten aan het woord" level={5} />
      <p class="font-display mt-4 text-7xl font-bold tracking-tight text-pine-900">10,0</p>
      <p class="mt-2 text-sm text-ink/60">gemiddelde beoordeling<br />op basis van 101 reviews</p>
      <div class="mt-4 flex justify-center gap-1 md:justify-start" aria-hidden="true">
        {
          Array.from({ length: 5 }, () => (
            <svg class="size-5 text-warmte" viewBox="0 0 20 20" fill="currentColor">
              <path d="m10 1.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5Z" />
            </svg>
          ))
        }
      </div>
    </div>
    <div class="border-pine-900/10 md:border-l md:pl-10">
      <p class="text-lg leading-relaxed text-ink/80">
        Onze klanten beoordelen ons met een perfecte score — van eerste adviesgesprek tot
        werkende installatie. De reviews worden onafhankelijk verzameld via Trustoo, waar we de
        badge <strong>Top Score 2026</strong> dragen.
      </p>
      <!-- TODO: hier de Trustoo review-widget embedden -->
      <p class="mt-3 font-mono text-xs tracking-widest text-ink/45 uppercase">
        Trustoo · Top Score 2026
      </p>
      <a href={url('/offerte-aanvragen/')} class="btn btn-dark mt-6">Word ook een tevreden klant</a>
    </div>
  </div>
</section>

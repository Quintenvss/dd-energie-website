---
/**
 * Warmtepomp-paneel in dezelfde app-stijl als EnergyFlow:
 * buitenlucht → warmtepomp (draaiende ventilator) → woning op temperatuur.
 * Illustratief (voorbeeldweergave), geen echte meetdata.
 */
---

<div
  class="w-full max-w-md rounded-3xl border border-white/10 bg-pine-950 p-6 shadow-2xl shadow-pine-900/30 sm:p-7"
  role="img"
  aria-label="Voorbeeld van slimme verwarming: de warmtepomp haalt warmte uit de buitenlucht en verwarmt de woning naar 21 graden"
>
  <div class="flex items-center justify-between">
    <p class="flex items-center gap-2 text-sm font-semibold text-white">
      <span class="relative flex size-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-warmte opacity-60"></span>
        <span class="relative inline-flex size-2 rounded-full bg-warmte"></span>
      </span>
      Slimme verwarming
    </p>
    <p class="font-mono text-[10px] tracking-widest text-white/40 uppercase">voorbeeldweergave</p>
  </div>

  <div class="mt-6">
    <!-- Buitenlucht -->
    <div class="flex items-center gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-white/10">
        <svg class="size-5 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M3 8h9a3 3 0 1 0-3-3M3 12h14a3 3 0 1 1-3 3M3 16h7a2.5 2.5 0 1 1-2.5 2.5" />
        </svg>
      </span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-white">Buitenlucht</p>
        <p class="text-xs text-white/45">gratis warmtebron</p>
      </div>
      <p class="font-mono text-lg text-white">7<span class="text-xs text-white/45">°C</span></p>
    </div>

    <div class="hf-connector" aria-hidden="true"><i></i></div>

    <!-- Warmtepomp -->
    <div class="flex items-center gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-white/10">
        <svg class="size-6 text-warmte" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="4" width="19" height="16" rx="3" />
          <g class="hf-fan">
            <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" />
            <path d="M12 10.4c0-2 .9-3.4 2.2-3.4 1 0 1.6.8 1.6 1.7 0 1.4-1.8 1.7-3.8 1.7Z" />
            <path d="M10.6 12.8c-1.7-1-2.2-2.6-1.6-3.7.5-.9 1.5-1 2.3-.6 1.2.7.7 2.5-.7 4.3Z" />
            <path d="M13.4 12.8c1.7 1 2.2 2.6 1.6 3.7-.5.9-1.5 1-2.3.6-1.2-.7-.7-2.5.7-4.3Z" />
          </g>
        </svg>
      </span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-white">Warmtepomp</p>
        <p class="text-xs text-white/45">rendement (COP)</p>
      </div>
      <p class="font-mono text-lg text-warmte">4,7</p>
    </div>

    <div class="hf-connector" aria-hidden="true"><i></i></div>

    <!-- Woning -->
    <div class="flex items-center gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-white/10">
        <svg class="size-5 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11.5 12 5l8 6.5" />
          <path d="M6 10v9.5h12V10" />
        </svg>
      </span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-white">Woning</p>
        <p class="text-xs text-white/45">binnentemperatuur</p>
      </div>
      <div class="flex items-center gap-2.5">
        <svg class="hf-waves h-6 w-5 text-warmte/70" viewBox="0 0 20 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M4 20c-2-2.5 2-4.5 0-7s2-4.5 0-7" />
          <path d="M10 20c-2-2.5 2-4.5 0-7s2-4.5 0-7" />
          <path d="M16 20c-2-2.5 2-4.5 0-7s2-4.5 0-7" />
        </svg>
        <p class="font-mono text-lg text-white">21,0<span class="text-xs text-white/45">°C</span></p>
      </div>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-3 border-t border-white/10 pt-5">
    <div>
      <p class="font-mono text-base text-white">−80%</p>
      <p class="text-xs text-white/45">gasverbruik</p>
    </div>
    <div>
      <p class="font-mono text-base text-white">A+++</p>
      <p class="text-xs text-white/45">energielabel</p>
    </div>
  </div>
</div>

<style>
  .hf-connector {
    position: relative;
    margin-left: 1.375rem;
    height: 22px;
    width: 2px;
    background: color-mix(in srgb, white 12%, transparent);
    border-radius: 1px;
  }
  .hf-connector i {
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-warmte);
    transform: translateX(-50%);
    animation: hf-drip 1.8s ease-in-out infinite;
  }
  @keyframes hf-drip {
    0% {
      top: -2px;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 3px);
      opacity: 0;
    }
  }

  .hf-fan {
    transform-origin: 12px 12px;
    animation: hf-spin 4.5s linear infinite;
  }
  @keyframes hf-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hf-waves path {
    animation: hf-shimmer 2.4s ease-in-out infinite;
  }
  .hf-waves path:nth-child(2) {
    animation-delay: 0.4s;
  }
  .hf-waves path:nth-child(3) {
    animation-delay: 0.8s;
  }
  @keyframes hf-shimmer {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-1.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-connector i,
    .hf-fan,
    .hf-waves path {
      animation: none;
    }
    .hf-connector i {
      top: 40%;
    }
  }
</style>

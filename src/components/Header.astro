---
import { url } from '../lib/links';

const nav = [
  { href: url('/thuisbatterij-plaatsen/'), label: 'Thuisbatterij' },
  { href: url('/warmtepomp-plaatsen/'), label: 'Warmtepomp' },
  { href: url('/over-ons/'), label: 'Over ons' },
  { href: url('/blog/'), label: 'Blog' },
  { href: url('/contact/'), label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-pine-900/10 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={url('/')} class="flex items-center gap-2.5" aria-label="DD Energie — home">
      <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="31" height="31" rx="8" class="fill-pine-900" />
        <path d="M19.5 6.5 11 19h5l-2 8.5L23 14h-5l1.5-7.5Z" class="fill-stroom" />
      </svg>
      <span class="font-display text-lg font-bold tracking-tight text-pine-900">
        DD<span class="text-pine-600">Energie</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Hoofdmenu">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-pine-600',
              path === item.href ? 'text-pine-600' : 'text-ink/80',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="tel:+31850608951"
        class="hidden items-center gap-2 text-sm font-semibold text-pine-900 transition hover:text-pine-600 lg:flex"
      >
        <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 3.5h4l1.5 4-2 1.5a12 12 0 0 0 4 4l1.5-2 4 1.5v4a1.5 1.5 0 0 1-1.6 1.5C7.6 17.4 2.6 12.4 2 4.9A1.5 1.5 0 0 1 3.5 3.5Z" />
        </svg>
        085 060 8951
      </a>
      <a href={url('/offerte-aanvragen/')} class="btn btn-dark !px-5 !py-2.5">Offerte aanvragen</a>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center rounded-lg border border-pine-900/15 p-2"
        aria-label="Menu openen"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-2xl border border-pine-900/10 bg-white p-3 shadow-xl"
        aria-label="Mobiel menu"
      >
        {
          nav.map((item) => (
            <a href={item.href} class="rounded-lg px-3 py-2 text-sm font-medium hover:bg-paper">
              {item.label}
            </a>
          ))
        }
        <a
          href={url('/offerte-aanvragen/')}
          class="mt-1 rounded-lg bg-pine-900 px-3 py-2 text-center text-sm font-semibold text-white"
        >
          Offerte aanvragen
        </a>
      </nav>
    </details>
  </div>
</header>

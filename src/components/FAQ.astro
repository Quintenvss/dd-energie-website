---
import Eyebrow from './Eyebrow.astro';
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = 'Veelgestelde vragen' } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
  <div class="reveal">
    <Eyebrow label="FAQ" level={2} />
    <h2 class="font-display mt-3 text-3xl font-bold tracking-tight text-pine-900 sm:text-4xl">
      {title}
    </h2>
  </div>
  <div class="mt-8 space-y-3">
    {
      items.map((item) => (
        <details class="reveal group rounded-2xl border border-pine-900/10 bg-white px-6 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-pine-900">
            {item.q}
            <svg
              class="size-5 shrink-0 transition-transform group-open:rotate-45"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink/75">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

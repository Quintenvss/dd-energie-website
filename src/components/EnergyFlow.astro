---
/**
 * Signatuur-element: strak energie-dashboard in app-stijl.
 * Illustratief (voorbeeldweergave), geen echte meetdata.
 */
---

<div
  class="w-full max-w-md rounded-3xl border border-white/10 bg-pine-950 p-6 shadow-2xl shadow-pine-900/30 sm:p-7"
  role="img"
  aria-label="Voorbeeld van slim energiebeheer: zonnepanelen laden de thuisbatterij, de woning gebruikt eigen stroom"
>
  <div class="flex items-center justify-between">
    <p class="flex items-center gap-2 text-sm font-semibold text-white">
      <span class="relative flex size-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-stroom opacity-60"></span>
        <span class="relative inline-flex size-2 rounded-full bg-stroom"></span>
      </span>
      Slim energiebeheer
    </p>
    <p class="font-mono text-[10px] tracking-widest text-white/40 uppercase">voorbeeldweergave</p>
  </div>

  <div class="mt-6 space-y-0">
    <!-- Zonnepanelen -->
    <div class="flex items-center gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-white/10">
        <svg class="size-5 text-warmte" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" />
        </svg>
      </span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-white">Zonnepanelen</p>
        <p class="text-xs text-white/45">opwek nu</p>
      </div>
      <p class="font-mono text-lg text-white">3,2 <span class="text-xs text-white/45">kW</span></p>
    </div>

    <div class="fl-connector" aria-hidden="true"><i></i></div>

    <!-- Thuisbatterij -->
    <div class="flex items-center gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-white/10">
        <svg class="size-5 text-stroom" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="7" width="12" height="14" rx="2.5" />
          <path d="M10 4h4M12 11l-1.8 3h3.6L12 17" />
        </svg>
      </span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-white">Thuisbatterij</p>
        <div class="mt-1.5 h-1.5 w-full max-w-[9rem] overflow-hidden rounded-full bg-white/10">
          <div class="h-full w-[78%] rounded-full bg-stroom"></div>
        </div>
      </div>
      <p class="font-mono text-lg text-stroom">78<span class="text-xs">%</span></p>
    </div>

    <div class="fl-connector" aria-hidden="true"><i></i></div>

    <!-- Woning -->
    <div class="flex items-center gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white/5 ring-1 ring-white/10">
        <svg class="size-5 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11.5 12 5l8 6.5" />
          <path d="M6 10v9.5h12V10" />
        </svg>
      </span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-white">Woning</p>
        <p class="text-xs text-white/45">verbruik nu</p>
      </div>
      <p class="font-mono text-lg text-white">1,1 <span class="text-xs text-white/45">kW</span></p>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-3 border-t border-white/10 pt-5">
    <div>
      <p class="font-mono text-base text-white">9,4 kWh</p>
      <p class="text-xs text-white/45">vandaag opgeslagen</p>
    </div>
    <div>
      <p class="font-mono text-base text-white">71%</p>
      <p class="text-xs text-white/45">zelfverbruik</p>
    </div>
  </div>
</div>

<style>
  /* Verticale verbindingslijn met een subtiel 'stromend' bolletje */
  .fl-connector {
    position: relative;
    margin-left: 1.375rem; /* midden van de 44px-icoontegel */
    height: 22px;
    width: 2px;
    background: color-mix(in srgb, white 12%, transparent);
    border-radius: 1px;
  }
  .fl-connector i {
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-stroom);
    transform: translateX(-50%);
    animation: fl-drip 1.8s ease-in-out infinite;
  }
  @keyframes fl-drip {
    0% {
      top: -2px;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 3px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fl-connector i {
      animation: none;
      top: 40%;
    }
  }
</style>

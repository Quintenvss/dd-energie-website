---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import HeatFlow from '../components/HeatFlow.astro';
import ProductCard from '../components/ProductCard.astro';
import Steps from '../components/Steps.astro';
import FAQ from '../components/FAQ.astro';
import { hybrideWarmtepompen, allElectricWarmtepompen } from '../data/products';
import { faqWarmtepomp, faqSchema } from '../data/faq';
import { url } from '../lib/links';
---

<Base
  title="Warmtepomp plaatsen | Hybride & all-electric — DD Energie"
  description="Warmtepomp laten plaatsen? Hybride vanaf € 3.894 incl. subsidie, all-electric vanaf € 8.000. Persoonlijk advies en installatie door gecertificeerde monteurs."
  schema={[faqSchema(faqWarmtepomp, 'https://ddenergie.nl/warmtepomp-plaatsen/')]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-pine-950 text-white">
    <div class="absolute inset-0 -z-0" aria-hidden="true">
      <div class="absolute -top-32 right-[-15%] size-[34rem] rounded-full bg-pine-700/30 blur-3xl"></div>
      <div class="absolute bottom-[-40%] left-[-10%] size-[28rem] rounded-full bg-warmte/10 blur-3xl"></div>
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2">
      <div>
        <Eyebrow label="Warmtepomp" level={3} tone="light" />
        <h1 class="font-display mt-5 text-4xl font-bold tracking-tight sm:text-5xl">
          Verwarmen én koelen, <span class="hl">zonder gas</span>
        </h1>
        <p class="mt-6 max-w-lg leading-relaxed text-white/75">
          Een warmtepomp haalt warmte uit de buitenlucht en maakt daar comfort van — stil,
          energiezuinig en zonder fossiele brandstoffen. Hybride naast je cv-ketel of volledig
          all-electric: wij adviseren wat bij jouw woning past.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={url('/offerte-aanvragen/')} class="btn btn-lime">Vrijblijvend advies</a>
          <a href="#modellen" class="btn btn-outline-light">Bekijk de topmodellen</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2.5 text-sm text-white/70">
          {
            ['Gemiddeld € 2.000–3.500 ISDE-subsidie', 'Subsidieaanvraag regelen wij mee'].map((usp) => (
              <li class="flex items-center gap-2">
                <svg class="size-4 shrink-0 text-warmte" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 8.5 6 12l8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                {usp}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal justify-self-center lg:justify-self-end">
        <HeatFlow />
      </div>
    </div>
  </section>

  <!-- Hybride vs all-electric -->
  <section class="border-y border-pine-900/10 bg-white/60">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="reveal max-w-2xl">
        <Eyebrow label="Welk type past bij jou?" level={2} tone="warmte" />
        <h2 class="font-display mt-3 text-3xl font-bold tracking-tight text-pine-900 sm:text-4xl">
          Hybride of all-electric?
        </h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="reveal rounded-3xl border border-pine-900/10 bg-white p-8 sm:p-10">
          <p class="font-mono text-xs tracking-widest text-warmte-dark uppercase">hybride · vanaf € 3.894</p>
          <h3 class="font-display mt-2 text-2xl font-bold text-pine-900">Hybride warmtepomp</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            Werkt slim samen met je bestaande cv-ketel: de warmtepomp verwarmt je woning, de
            ketel springt bij op koude dagen en verzorgt het warme water. Geen grote verbouwing
            nodig — je bespaart direct 60 tot 80% op je gasverbruik.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-ink/80">
            {
              ['Geschikt voor vrijwel iedere woning', 'Lagere investering, sneller terugverdiend', 'Hoge CO₂-reductie', 'Ook bij beperkte isolatie'].map(
                (punt) => (
                  <li class="flex gap-2.5">
                    <span class="mt-1.5 h-2 w-3 shrink-0 rounded-[2px] bg-warmte" aria-hidden="true" />
                    {punt}
                  </li>
                )
              )
            }
          </ul>
        </div>
        <div class="reveal rounded-3xl border border-pine-900/10 bg-white p-8 sm:p-10">
          <p class="font-mono text-xs tracking-widest text-warmte-dark uppercase">all-electric · vanaf € 8.000</p>
          <h3 class="font-display mt-2 text-2xl font-bold text-pine-900">All-electric warmtepomp</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            Vervangt je cv-ketel volledig: 100% elektrisch, 0% gas. De duurzaamste keuze voor
            goed geïsoleerde woningen — vaak gecombineerd met zonnepanelen en een thuisbatterij
            voor maximale onafhankelijkheid.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-ink/80">
            {
              ['Volledig van het gas af', 'Verwarmen én koelen in één systeem', 'Hoogste besparing op lange termijn', 'Goede isolatie vereist'].map((punt) => (
                <li class="flex gap-2.5">
                  <span class="mt-1.5 h-2 w-3 shrink-0 rounded-[2px] bg-warmte" aria-hidden="true" />
                  {punt}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Topmodellen -->
  <section id="modellen" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="reveal max-w-2xl">
      <Eyebrow label="Top 3 hybride" level={4} tone="warmte" />
      <h2 class="font-display mt-3 text-3xl font-bold tracking-tight text-pine-900">
        Meest gekozen hybride warmtepompen
      </h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {hybrideWarmtepompen.map((p) => <ProductCard product={p} tone="warmte" />)}
    </div>

    <div class="reveal mt-16 max-w-2xl">
      <Eyebrow label="Top 3 all-electric" level={5} tone="warmte" />
      <h2 class="font-display mt-3 text-3xl font-bold tracking-tight text-pine-900">
        Meest gekozen all-electric warmtepompen
      </h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {allElectricWarmtepompen.map((p) => <ProductCard product={p} tone="warmte" />)}
    </div>
  </section>

  <Steps />
  <FAQ items={faqWarmtepomp} title="Veelgestelde vragen over warmtepompen" />
</Base>

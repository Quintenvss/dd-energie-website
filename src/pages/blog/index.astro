---
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/links';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Blog — Duurzaam Direct Energie"
  description="Alles over warmtepompen, thuisbatterijen en duurzame energie: kennis, tips en advies voor de overstap naar een duurzaam huis."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <Eyebrow label="Kennisbank" level={3} />
      <h1 class="font-display mt-4 text-4xl font-bold tracking-tight text-pine-900 sm:text-5xl">
        Blog
      </h1>
      <p class="mt-4 leading-relaxed text-ink/70">
        Alles over warmtepompen, thuisbatterijen en duurzame energie. Onze experts delen kennis,
        tips en advies voor de overstap naar een duurzaam huis.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={url(`/blog/${post.id}/`)}
            class="reveal group flex flex-col rounded-2xl border border-pine-900/10 bg-white p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <p
              class:list={[
                'font-mono text-[11px] tracking-widest uppercase',
                post.data.category === 'Warmtepompen' ? 'text-warmte-dark' : 'text-stroom-dark',
              ]}
            >
              {post.data.category}
            </p>
            <h2 class="font-display mt-3 text-xl font-bold text-pine-900 group-hover:text-pine-600">
              {post.data.title}
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">{post.data.description}</p>
            <p class="mt-5 text-xs text-ink/45">{fmt.format(post.data.pubDate)}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-14 rounded-2xl bg-pine-100 px-6 py-5 text-sm text-pine-900">
      Advies nodig? <a href={url('/offerte-aanvragen/')} class="font-semibold underline">Vraag een gratis offerte aan</a>
      of bel <a href="tel:+31850608951" class="font-semibold underline">085 060 8951</a>.
    </p>
  </section>
</Base>
